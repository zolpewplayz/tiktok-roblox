# ─── TikTok Live Bridge — Environment Variables ───────────────────────────────
# Copy this file to .env and fill in your values.
# NEVER commit your .env file to git.

# Your TikTok username (without @)
TIKTOK_USERNAME=your_tiktok_username

# Port the Express server will listen on
PORT=3000

# Secret key shared with your Roblox Script (keep this private!)
# Generate a strong random string, e.g.: openssl rand -hex 32
API_SECRET=CHANGE_THIS_TO_A_STRONG_SECRET_KEY
